# Porta de execução
PORT=3001

# Fuso Horário
TZ=America/Rio_Branco

# Domínio e URL do site
SITE_DOMAIN=camerasriobranco.com.br
SITE_BASE_URL=https://camerasriobranco.com.br

# Fonte do Scanner de Câmeras (prefeitura | fallback)
SCANNER_SOURCE=prefeitura

# Bucket do Firebase Storage
FIREBASE_STORAGE_BUCKET=camerasriobranco.firebasestorage.app

# E-mail de Administrador
ADMIN_EMAIL=seu-email@dominio.com

# Contato Comercial para Patrocínios (WhatsApp com DDI+DDD, apenas números)
COMMERCIAL_WHATSAPP=5568999999999
COMMERCIAL_EMAIL=comercial@camerasriobranco.com.br

# Intervalo de atualização do scanner (em ms, padrão: 60000 = 1 min)
UPDATE_INTERVAL_MS=60000

# Limite de requisições simultâneas
CONCURRENCY_LIMIT=20

# ─── Telemetria do Rio Acre (/rio) ────────────────────────────────────────────
# Credenciais da API HidroWebService da ANA (fonte primária; sem elas usa só o XML legado, sem qualidade de dado)
ANA_HIDROWEB_USUARIO=
ANA_HIDROWEB_SENHA=
# Fuso em que a ANA publica as datas (padrão -05:00 = hora local de Rio Branco). Confira uma vez comparando
# com o site da ANA; se a leitura aparecer "no futuro" o painel avisa.
ANA_DATA_UTC_OFFSET=-05:00
# Minutos sem leitura nova até a página avisar "dado desatualizado"
RIO_STALE_MINUTES=120
# true = usa rio_service.py como 1ª fonte no Node (padrão false; o Node já fala direto com a ANA)
RIO_PYTHON_ENGINE=false

